<?xml version="1.0" encoding="utf-8"?>
<!-- Les données financières ne partent jamais vers le cloud Google ni vers un autre appareil
     de façon automatique : seule la sauvegarde chiffrée .sbfbackup sert au transfert. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
